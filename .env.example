# Dify + SQLBot lab deployment variables.
# Copy this file to .env and edit values before running install.sh.

# Host paths
INSTALL_ROOT=/opt/dify-sqlbot
DIFY_DIR=/opt/dify-sqlbot/dify
SQLBOT_DATA_ROOT=/opt/dify-sqlbot/sqlbot/data

# Public access ports
DIFY_PORT=8088
SQLBOT_WEB_BIND=0.0.0.0
SQLBOT_WEB_PORT=8000

# Keep SQLBot native MCP local. Dify uses SQLBot MCP Adapter instead.
SQLBOT_MCP_BIND=127.0.0.1
SQLBOT_MCP_PORT=8001

# Images. sqlbot-dify-mcp is built locally from ./sqlbot-dify-mcp by default.
SQLBOT_IMAGE=dataease/sqlbot:latest
SQLBOT_DIFY_MCP_IMAGE=sqlbot-dify-mcp:local
SQLBOT_DIFY_MCP_BUILD_CONTEXT=./sqlbot-dify-mcp
PG_LOCAL_PROXY_IMAGE=alpine/socat:latest

# SQLBot account used by adapter. Change after first login if needed.
SQLBOT_BASE_URL=http://127.0.0.1:8000
SQLBOT_USERNAME=admin
SQLBOT_PASSWORD=<SQLBOT_ADMIN_PASSWORD>

# Docker bridge services. These should not be exposed publicly.
DOCKER_HOST_BRIDGE_IP=172.17.0.1
SQLBOT_DIFY_MCP_PORT=8017

# Local PostgreSQL proxy for SQLBot datasource access.
# If the business PostgreSQL is on another internal host, change target host/port.
PG_LOCAL_PROXY_PORT=15432
PG_LOCAL_TARGET_HOST=127.0.0.1
PG_LOCAL_TARGET_PORT=5432

# Dify SSRF proxy must allow Docker bridge service calls.
SSRF_PROXY_ALLOW_PRIVATE_IPS=172.17.0.1/32
